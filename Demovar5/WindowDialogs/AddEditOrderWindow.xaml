<Window x:Class="Demovar5.WindowDialogs.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demovar5.WindowDialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding WindowTitle}" 
                   FontFamily="Calibri"
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#0000FF"
                   Margin="0,0,0,20"/>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка - основная информация -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Основная информация" 
                               FontFamily="Calibri"
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- ID заказа (только для редактирования) -->
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock Text="ID заказа" 
                                   FontFamily="Calibri"
                                   FontSize="14" 
                                   Margin="0,0,0,5"/>
                        <hc:TextBox Text="{Binding Order.OrderID}" 
                                    Height="35" 
                                    FontSize="14"
                                    IsReadOnly="True"
                                    Background="#F5F5F5"
                                    Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- Номер заказа -->
                    <TextBlock Text="Номер заказа *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <hc:NumericUpDown x:Name="OrderNumberNumeric"
                                      Value="{Binding Order.OrderNumber, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="1"
                                      Maximum="999999"
                                      Height="35" 
                                      FontSize="14"
                                      Margin="0,0,0,15"/>

                    <!-- Дата заказа -->
                    <TextBlock Text="Дата заказа *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <DatePicker x:Name="OrderDatePicker"
                                SelectedDate="{Binding Order.OrderDate, UpdateSourceTrigger=PropertyChanged}"
                                Height="35" 
                                FontSize="14"
                                Margin="0,0,0,15"/>

                    <!-- Дата доставки -->
                    <TextBlock Text="Дата доставки *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <DatePicker x:Name="DeliveryDatePicker"
                                SelectedDate="{Binding Order.DeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                                Height="35" 
                                FontSize="14"
                                Margin="0,0,0,15"/>

                    <!-- Пункт выдачи -->
                    <TextBlock Text="Пункт выдачи *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="PickupPointComboBox"
                              Height="35" 
                              FontSize="14"
                              DisplayMemberPath="Address"
                              SelectedValuePath="PickupPointID"
                              SelectedValue="{Binding Order.PickupPointID}"
                              Margin="0,0,0,15"/>

                    <!-- ФИО клиента -->
                    <TextBlock Text="ФИО клиента *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <hc:TextBox x:Name="ClientNameTextBox"
                                Text="{Binding Order.ClientFullName, UpdateSourceTrigger=PropertyChanged}" 
                                Height="35" 
                                FontSize="14"
                                hc:InfoElement.Placeholder="Введите ФИО клиента"
                                hc:InfoElement.Necessary="True"
                                Margin="0,0,0,15"/>

                    <!-- Код получения -->
                    <TextBlock Text="Код получения *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <hc:NumericUpDown x:Name="PickupCodeNumeric"
                                      Value="{Binding Order.PickupCode, UpdateSourceTrigger=PropertyChanged}"
                                      Minimum="100"
                                      Maximum="999"
                                      Height="35" 
                                      FontSize="14"
                                      Margin="0,0,0,15"/>

                    <!-- Статус заказа -->
                    <TextBlock Text="Статус заказа *" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="StatusComboBox"
                              Height="35" 
                              FontSize="14"
                              SelectedItem="{Binding Order.OrderStatus}"
                              Margin="0,0,0,15">
                        <ComboBoxItem Content="Новый"/>
                        <ComboBoxItem Content="Завершен"/>
                    </ComboBox>
                </StackPanel>

                <!-- Правая колонка - состав заказа -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Состав заказа" 
                               FontFamily="Calibri"
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <!-- Кнопка добавления товара -->
                    <Button Content="+ Добавить товар" 
                            Height="40"
                            FontSize="14"
                            Margin="0,0,0,15"
                            Style="{StaticResource ButtonSuccess}"
                            Click="AddProductToOrder_Click"/>

                    <!-- Список товаров в заказе -->
                    <ListView x:Name="OrderProductsListView" 
                              Height="400"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Товар" Width="200" DisplayMemberBinding="{Binding ProductName}"/>
                                <GridViewColumn Header="Кол-во" Width="60" DisplayMemberBinding="{Binding Quantity}"/>
                                <GridViewColumn Header="">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" 
                                                    Width="30" 
                                                    Height="30"
                                                    Style="{StaticResource ButtonDanger}"
                                                    Click="RemoveProductFromOrder_Click"
                                                    Tag="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Общая информация -->
                    <Border BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            Padding="10"
                            Margin="0,15,0,0"
                            Background="#F5F5F5">
                        <StackPanel>
                            <TextBlock FontFamily="Calibri" FontSize="14" Margin="0,0,0,5">
                                <Run Text="Товаров в заказе: "/>
                                <Run Text="{Binding TotalProductsCount}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontFamily="Calibri" FontSize="14">
                                <Run Text="Общая стоимость: "/>
                                <Run Text="{Binding TotalPrice, StringFormat=N2}" FontWeight="Bold"/>
                                <Run Text=" руб."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Отмена" 
                    Height="45"
                    FontSize="16"
                    Margin="0,0,5,0"
                    Style="{StaticResource ButtonDefault}"
                    Click="Cancel_Click"/>

            <Button Grid.Column="1" 
                    Content="{Binding SaveButtonText}" 
                    Height="45"
                    FontSize="16"
                    Margin="5,0,0,0"
                    Style="{StaticResource ButtonSuccess}"
                    Click="Save_Click"/>
        </Grid>

        <!-- Growl для уведомлений -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                      Grid.Row="0"
                      HorizontalAlignment="Right">
            <StackPanel hc:Growl.GrowlParent="True" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Window>
