<Window x:Class="Demovar5.WindowDialogs.ViewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demovar5.WindowDialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="Просмотр заказа"
        Height="650" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontFamily="Calibri" FontSize="24" FontWeight="Bold" Foreground="#0000FF">
                <Run Text="Заказ №"/>
                <Run Text="{Binding Order.OrderNumber}"/>
            </TextBlock>
            <TextBlock Text="{Binding StatusText}" 
                       FontFamily="Calibri"
                       FontSize="16" 
                       Foreground="{Binding StatusColor}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Информация о заказе -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Основная информация -->
                <Border BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Основная информация" 
                                   FontFamily="Calibri"
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Дата заказа -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Дата заказа:" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Order.OrderDate, StringFormat=dd.MM.yyyy}" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Дата доставки -->
                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="Дата доставки:" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding Order.DeliveryDate, StringFormat=dd.MM.yyyy}" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Клиент -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Клиент:" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding Order.ClientFullName}" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Пункт выдачи -->
                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                       Text="Пункт выдачи:" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding PickupPointAddress}" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <!-- Код получения -->
                            <TextBlock Grid.Row="4" Grid.Column="0" 
                                       Text="Код получения:" 
                                       FontFamily="Calibri"
                                       FontSize="14"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" 
                                       Text="{Binding Order.PickupCode}" 
                                       FontFamily="Calibri"
                                       FontSize="14" 
                                       FontWeight="Bold"
                                       Foreground="#0000FF"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Состав заказа -->
                <Border BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        Padding="15"
                        Margin="0,0,0,15"
                        CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Состав заказа" 
                                   FontFamily="Calibri"
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <ListView x:Name="OrderProductsListView" 
                                  Height="200"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Артикул" Width="100" DisplayMemberBinding="{Binding ArticleNumber}"/>
                                    <GridViewColumn Header="Наименование" Width="350" DisplayMemberBinding="{Binding ProductName}"/>
                                    <GridViewColumn Header="Цена" Width="100" DisplayMemberBinding="{Binding Price, StringFormat=N2}"/>
                                    <GridViewColumn Header="Скидка %" Width="80" DisplayMemberBinding="{Binding Discount}"/>
                                    <GridViewColumn Header="Кол-во" Width="80" DisplayMemberBinding="{Binding Quantity}"/>
                                    <GridViewColumn Header="Сумма" Width="100" DisplayMemberBinding="{Binding Total, StringFormat=N2}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Итого -->
                <Border BorderBrush="#0000FF" 
                        BorderThickness="2" 
                        Padding="15"
                        Background="#F0F8FF"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Итого к оплате:" 
                                       FontFamily="Calibri"
                                       FontSize="18" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                   FontFamily="Calibri"
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="#0000FF"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding TotalPrice, StringFormat=N2}"/>
                            <Run Text=" руб." FontSize="16"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" 
                Content="Закрыть" 
                Height="45"
                FontSize="16"
                Margin="0,20,0,0"
                Style="{StaticResource ButtonPrimary}"
                Click="Close_Click"/>
    </Grid>
</Window>
