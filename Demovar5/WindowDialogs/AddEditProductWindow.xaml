<Window x:Class="Demovar5.WindowDialogs.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demovar5.WindowDialogs"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="750" 
        Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding WindowTitle}" 
                   FontFamily="Calibri"
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#0000FF"
                   Margin="0,0,0,20"/>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ID товара (только для редактирования) -->
                <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <TextBlock Text="ID товара" 
                               FontFamily="Calibri"
                               FontSize="14" 
                               Margin="0,0,0,5"/>
                    <hc:TextBox Text="{Binding Product.ProductID}" 
                                Height="35" 
                                FontSize="14"
                                IsReadOnly="True"
                                Background="#F5F5F5"
                                Margin="0,0,0,15"/>
                </StackPanel>

                <!-- Артикул -->
                <TextBlock Text="Артикул *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <hc:TextBox x:Name="ArticleNumberTextBox"
                            Text="{Binding Product.ArticleNumber, UpdateSourceTrigger=PropertyChanged}" 
                            Height="35" 
                            FontSize="14"
                            hc:InfoElement.Placeholder="Введите артикул (например, А112Т4)"
                            hc:InfoElement.Necessary="True"
                            Margin="0,0,0,15"/>

                <!-- Наименование товара -->
                <TextBlock Text="Наименование товара *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <hc:TextBox x:Name="ProductNameTextBox"
                            Text="{Binding Product.ProductName, UpdateSourceTrigger=PropertyChanged}" 
                            Height="35" 
                            FontSize="14"
                            hc:InfoElement.Placeholder="Введите наименование"
                            hc:InfoElement.Necessary="True"
                            Margin="0,0,0,15"/>

                <!-- Категория товара -->
                <TextBlock Text="Категория товара *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryComboBox"
                          Height="35" 
                          FontSize="14"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryID"
                          SelectedValue="{Binding Product.CategoryID}"
                          Margin="0,0,0,15"/>

                <!-- Производитель -->
                <TextBlock Text="Производитель *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="ManufacturerComboBox"
                          Height="35" 
                          FontSize="14"
                          DisplayMemberPath="ManufacturerName"
                          SelectedValuePath="ManufacturerID"
                          SelectedValue="{Binding Product.ManufacturerID}"
                          Margin="0,0,0,15"/>

                <!-- Поставщик -->
                <TextBlock Text="Поставщик *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="SupplierComboBox"
                          Height="35" 
                          FontSize="14"
                          DisplayMemberPath="SupplierName"
                          SelectedValuePath="SupplierID"
                          SelectedValue="{Binding Product.SupplierID}"
                          Margin="0,0,0,15"/>

                <!-- Единица измерения -->
                <TextBlock Text="Единица измерения *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="UnitComboBox"
                          Height="35" 
                          FontSize="14"
                          DisplayMemberPath="UnitName"
                          SelectedValuePath="UnitID"
                          SelectedValue="{Binding Product.UnitID}"
                          Margin="0,0,0,15"/>

                <!-- Цена -->
                <TextBlock Text="Цена (руб.) *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <hc:NumericUpDown x:Name="PriceNumeric"
                                  Value="{Binding Product.Price, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  Maximum="9999999"
                                  DecimalPlaces="2"
                                  Height="35" 
                                  FontSize="14"
                                  Margin="0,0,0,15"/>

                <!-- Скидка -->
                <TextBlock Text="Скидка (%) *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <hc:NumericUpDown x:Name="DiscountNumeric"
                                  Value="{Binding Product.Discount, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  Maximum="100"
                                  Height="35" 
                                  FontSize="14"
                                  Margin="0,0,0,15"/>

                <!-- Количество на складе -->
                <TextBlock Text="Количество на складе *" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <hc:NumericUpDown x:Name="QuantityNumeric"
                                  Value="{Binding Product.QuantityInStock, UpdateSourceTrigger=PropertyChanged}"
                                  Minimum="0"
                                  Maximum="999999"
                                  Height="35" 
                                  FontSize="14"
                                  Margin="0,0,0,15"/>

                <!-- Описание товара -->
                <TextBlock Text="Описание товара" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox"
                         Text="{Binding Product.Description, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" 
                         FontSize="14"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>

                <!-- Фото товара -->
                <TextBlock Text="Фото товара" 
                           FontFamily="Calibri"
                           FontSize="14" 
                           Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Превью изображения -->
                    <Border Grid.Column="0" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1"
                            Width="200"
                            Height="200"
                            Margin="0,0,10,0">
                        <Image x:Name="PhotoPreview" 
                               Source="{Binding PhotoPreviewPath}" 
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Кнопки управления фото -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="Выбрать фото" 
                                Height="40"
                                FontSize="14"
                                Margin="0,0,0,10"
                                Style="{StaticResource ButtonPrimary}"
                                Click="SelectPhoto_Click"/>
                        <Button Content="Удалить фото" 
                                Height="40"
                                FontSize="14"
                                Style="{StaticResource ButtonDanger}"
                                Click="DeletePhoto_Click"/>
                        <TextBlock Text="Рекомендуемый размер: 300x200 пикселей" 
                                   FontFamily="Calibri"
                                   FontSize="11" 
                                   Foreground="#999999"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Отмена" 
                    Height="45"
                    FontSize="16"
                    Margin="0,0,5,0"
                    Style="{StaticResource ButtonDefault}"
                    Click="Cancel_Click"/>

            <Button Grid.Column="1" 
                    Content="{Binding SaveButtonText}" 
                    Height="45"
                    FontSize="16"
                    Margin="5,0,0,0"
                    Style="{StaticResource ButtonSuccess}"
                    Click="Save_Click"/>
        </Grid>

        <!-- Growl для уведомлений -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                      Grid.Row="0"
                      HorizontalAlignment="Right">
            <StackPanel hc:Growl.GrowlParent="True" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Window>
