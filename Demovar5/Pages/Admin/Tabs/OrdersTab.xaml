<Page x:Class="Demovar5.Pages.Admin.Tabs.OrdersTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demovar5.Pages.Admin.Tabs"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Управление заказами">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Управление заказами" 
                   FontFamily="Calibri"
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Список заказов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="15" 
                                Margin="0,0,0,10"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Информация о заказе -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Заказ №" 
                                                   FontFamily="Calibri"
                                                   FontSize="18" 
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OrderNumber}" 
                                                   FontFamily="Calibri"
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Margin="5,0,0,0"/>
                                        <TextBlock Text=" • " 
                                                   FontFamily="Calibri"
                                                   FontSize="18" 
                                                   Margin="10,0"/>
                                        <TextBlock Text="{Binding OrderStatus}" 
                                                   FontFamily="Calibri"
                                                   FontSize="16"
                                                   Foreground="{Binding StatusColor}"/>
                                    </StackPanel>
                                    
                                    <TextBlock FontFamily="Calibri" FontSize="14" Margin="0,0,0,5">
                                        <Run Text="Клиент: "/>
                                        <Run Text="{Binding ClientFullName}" FontWeight="Bold"/>
                                    </TextBlock>
                                    
                                    <TextBlock FontFamily="Calibri" FontSize="14" Margin="0,0,0,5">
                                        <Run Text="Дата заказа: "/>
                                        <Run Text="{Binding OrderDate, StringFormat=dd.MM.yyyy}" FontWeight="Bold"/>
                                    </TextBlock>
                                    
                                    <TextBlock FontFamily="Calibri" FontSize="14" Margin="0,0,0,5">
                                        <Run Text="Дата доставки: "/>
                                        <Run Text="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" FontWeight="Bold"/>
                                    </TextBlock>
                                    
                                    <TextBlock Text="{Binding PickupPointAddress}" 
                                               FontFamily="Calibri"
                                               FontSize="14" 
                                               Foreground="#666666"
                                               Margin="0,5,0,5"/>
                                    
                                    <TextBlock FontFamily="Calibri" FontSize="14">
                                        <Run Text="Код получения: "/>
                                        <Run Text="{Binding PickupCode}" FontWeight="Bold" Foreground="#0000FF"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Кнопки действий -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Content="Просмотр" 
                                            Height="35"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource ButtonInfo}"
                                            Click="ViewOrder_Click"
                                            Tag="{Binding OrderID}"/>
                                    <Button Content="Редактировать" 
                                            Height="35"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource ButtonWarning}"
                                            Click="EditOrder_Click"
                                            Tag="{Binding OrderID}"/>
                                    <Button Content="Удалить" 
                                            Height="35"
                                            Style="{StaticResource ButtonDanger}"
                                            Click="DeleteOrder_Click"
                                            Tag="{Binding OrderID}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Футер с информацией и кнопкой добавления -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="{Binding TotalOrdersText}" 
                       FontFamily="Calibri"
                       FontSize="14" 
                       VerticalAlignment="Center"/>
            <Button Content="Добавить заказ" 
                    HorizontalAlignment="Right"
                    Width="150"
                    Height="40"
                    FontSize="14"
                    Style="{StaticResource ButtonSuccess}"
                    Click="AddOrder_Click"/>
        </Grid>
    </Grid>
</Page>
