<Page x:Class="Demovar5.Pages.Admin.Tabs.ProductsTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demovar5.Pages.Admin.Tabs"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Управление товарами">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Управление товарами" 
                   FontFamily="Calibri"
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Панель фильтрации и поиска -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск -->
            <hc:SearchBar x:Name="SearchBar" 
                          Grid.Column="0"
                          Height="40" 
                          FontSize="16"
                          FontFamily="Calibri"
                          hc:InfoElement.Placeholder="Поиск по названию, артикулу, описанию..."
                          Style="{StaticResource SearchBarPlus}"
                          TextChanged="SearchBar_TextChanged"/>

            <!-- Фильтр по скидке -->
            <ComboBox x:Name="DiscountFilterComboBox" 
                      Grid.Column="1"
                      Height="40"
                      FontSize="14"
                      FontFamily="Calibri"
                      Margin="10,0,0,0"
                      SelectionChanged="DiscountFilter_SelectionChanged">
                <ComboBoxItem Content="Все диапазоны" IsSelected="True"/>
                <ComboBoxItem Content="0-10,99%"/>
                <ComboBoxItem Content="11-14,99%"/>
                <ComboBoxItem Content="15% и более"/>
            </ComboBox>

            <!-- Сортировка -->
            <ComboBox x:Name="SortComboBox" 
                      Grid.Column="2"
                      Height="40"
                      FontSize="14"
                      FontFamily="Calibri"
                      Margin="10,0,0,0"
                      SelectionChanged="Sort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="Цена ↑"/>
                <ComboBoxItem Content="Цена ↓"/>
                <ComboBoxItem Content="Остаток ↑"/>
                <ComboBoxItem Content="Остаток ↓"/>
            </ComboBox>
        </Grid>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="15" 
                                Margin="0,0,0,10"
                                Background="{Binding BackgroundColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото -->
                                <Image Grid.Column="0" 
                                       Source="{Binding PhotoFullPath}" 
                                       Width="130" 
                                       Height="130"
                                       Stretch="Uniform"/>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="{Binding CategoryName}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               Foreground="#666666"/>
                                    <TextBlock Text="{Binding ProductName}" 
                                               FontFamily="Calibri"
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,10"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               TextWrapping="Wrap"
                                               Foreground="#666666"
                                               Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: " 
                                                   FontFamily="Calibri"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding ManufacturerName}" 
                                                   FontFamily="Calibri"
                                                   FontSize="12" 
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: " 
                                                   FontFamily="Calibri"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding SupplierName}" 
                                                   FontFamily="Calibri"
                                                   FontSize="12" 
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Цена и остаток -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PriceDisplay}" 
                                                   FontFamily="Calibri"
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="{Binding PriceColor}"/>
                                        <TextBlock Text=" руб." 
                                                   FontFamily="Calibri"
                                                   FontSize="14" 
                                                   VerticalAlignment="Bottom"
                                                   Margin="5,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OriginalPriceDisplay}" 
                                               FontFamily="Calibri"
                                               FontSize="14" 
                                               Foreground="Red"
                                               TextDecorations="Strikethrough"
                                               Visibility="{Binding OriginalPriceVisibility}"/>
                                    <TextBlock FontFamily="Calibri" FontSize="12" Margin="0,5,0,0">
                                        <Run Text="На складе: "/>
                                        <Run Text="{Binding QuantityInStock}" FontWeight="Bold"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding UnitName}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DiscountText}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               Foreground="Red"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Кнопки действий -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Content="Редактировать" 
                                            Height="35"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource ButtonWarning}"
                                            Click="EditProduct_Click"
                                            Tag="{Binding ProductID}"/>
                                    <Button Content="Удалить" 
                                            Height="35"
                                            Style="{StaticResource ButtonDanger}"
                                            Click="DeleteProduct_Click"
                                            Tag="{Binding ProductID}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Футер с информацией и кнопкой добавления -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="{Binding TotalProductsText}" 
                       FontFamily="Calibri"
                       FontSize="14" 
                       VerticalAlignment="Center"/>
            <Button Content="Добавить товар" 
                    HorizontalAlignment="Right"
                    Width="150"
                    Height="40"
                    FontSize="14"
                    Style="{StaticResource ButtonSuccess}"
                    Click="AddProduct_Click"/>
        </Grid>
    </Grid>
</Page>
