<Page x:Class="Demovar5.Pages.Manager.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demovar5.Pages.Manager"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="Панель менеджера" 
      Background="White">

    <Grid x:Name="ManagerPageGrid">
        <TabControl TabStripPlacement="Left" Padding="0">
            <!-- Главная -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="200" Margin="10">
                        <TextBlock Text="🏠" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Главная" FontFamily="Calibri" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="White">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="/Resources/Images/icon.png" Width="200" Height="200"/>
                        <TextBlock Text="Добро пожаловать в систему" 
                                   FontFamily="Calibri"
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,10"
                                   Foreground="#0000FF"/>
                        <TextBlock Text="{Binding UserFullName}" 
                                   FontFamily="Calibri"
                                   FontSize="20" 
                                   HorizontalAlignment="Center"
                                   Foreground="#666666"/>
                        <TextBlock Text="Менеджер" 
                                   FontFamily="Calibri"
                                   FontSize="16" 
                                   HorizontalAlignment="Center"
                                   Foreground="#999999"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Товары (только просмотр) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="200" Margin="10">
                        <TextBlock Text="📦" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Товары" FontFamily="Calibri" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="ProductsFrame"/>
            </TabItem>

            <!-- Заказы (только просмотр) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Width="200" Margin="10">
                        <TextBlock Text="🛒" FontSize="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Заказы" FontFamily="Calibri" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="OrdersFrame"/>
            </TabItem>
        </TabControl>

        <!-- Панель управления внизу слева -->
        <StackPanel HorizontalAlignment="Left" 
                    Orientation="Horizontal" 
                    Margin="30,0,0,30" 
                    VerticalAlignment="Bottom">
            <Button x:Name="LogoutBtn" 
                    Width="50" 
                    Height="40" 
                    Click="LogoutBtn_Click"
                    Style="{StaticResource ButtonDanger}"
                    ToolTip="Выход">
                <TextBlock Text="🚪" FontSize="20"/>
            </Button>
        </StackPanel>

        <!-- Growl для уведомлений -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Right">
            <StackPanel hc:Growl.GrowlParent="True" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Page>
