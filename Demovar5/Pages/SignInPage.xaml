<Page x:Class="Demovar5.Pages.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demovar5.Pages"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="Вход в систему" 
      Background="White">

    <Grid x:Name="SignInGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с лого -->
        <Border Grid.Column="0" Background="#00FFFF">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/Resources/Images/icon.png" 
                       Width="200" 
                       Height="200" 
                       Margin="0,0,0,20"/>
                <TextBlock Text="МебельОрг" 
                           FontFamily="Calibri"
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#0000FF"/>
                <TextBlock Text="Система управления мебельным магазином" 
                           FontFamily="Calibri"
                           FontSize="16" 
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="20,10,20,0"
                           Foreground="#333333"/>
            </StackPanel>
        </Border>

        <!-- Правая панель с формой входа -->
        <StackPanel Grid.Column="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Width="450">
            
            <TextBlock Text="Добро пожаловать!" 
                       FontFamily="Calibri"
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>
            
            <TextBlock Text="Вход в систему" 
                       FontFamily="Calibri"
                       FontSize="20" 
                       Margin="0,0,0,30"
                       Foreground="#666666"
                       HorizontalAlignment="Center"/>

            <!-- Логин -->
            <TextBlock Text="Логин" 
                       FontFamily="Calibri"
                       FontSize="14" 
                       Margin="0,0,0,5"/>
            <hc:TextBox x:Name="LoginTextBox" 
                        hc:InfoElement.ShowClearButton="True"
                        Height="40" 
                        FontSize="16" 
                        FontFamily="Calibri"
                        hc:InfoElement.Placeholder="Введите логин"
                        Margin="0,0,0,20"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" 
                       FontFamily="Calibri"
                       FontSize="14" 
                       Margin="0,0,0,5"/>
            <hc:PasswordBox x:Name="PasswordBox" 
                            ShowEyeButton="True"
                            Height="40" 
                            FontSize="16" 
                            FontFamily="Calibri"
                            hc:InfoElement.Placeholder="Введите пароль"
                            Margin="0,0,0,30"/>

            <!-- Кнопки -->
            <Button x:Name="LoginBtn" 
                    Content="Войти" 
                    Height="45" 
                    FontSize="18" 
                    FontFamily="Calibri"
                    FontWeight="Medium"
                    Background="#0000FF"
                    Foreground="White"
                    Click="LoginBtn_Click"
                    Margin="0,0,0,15"
                    Style="{StaticResource ButtonPrimary}"/>

            <Button x:Name="GuestBtn" 
                    Content="Войти как гость" 
                    Height="45" 
                    FontSize="18" 
                    FontFamily="Calibri"
                    Click="GuestBtn_Click"
                    Style="{StaticResource ButtonDefault}"/>

            <!-- Тестовые данные для входа (убрать в продакшене) -->
            <TextBlock Text="Тестовые данные:" 
                       FontFamily="Calibri"
                       FontSize="12" 
                       Margin="0,30,0,5"
                       Foreground="#999999"/>
            <TextBlock FontFamily="Calibri" FontSize="11" Foreground="#999999">
                <Run Text="Админ: 94d5ous@gmail.com / uzWC67"/>
                <LineBreak/>
                <Run Text="Менеджер: ptec8ym@yahoo.com / LdNyos"/>
                <LineBreak/>
                <Run Text="Клиент: yzls62@outlook.com / JlFRCZ"/>
            </TextBlock>
        </StackPanel>

        <!-- Growl для уведомлений -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                      Grid.Column="1"
                      HorizontalAlignment="Right">
            <StackPanel hc:Growl.GrowlParent="True" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Page>
