<Page x:Class="Demovar5.Pages.Guest.GuestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Demovar5.Pages.Guest"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      Title="Просмотр товаров" 
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#00FFFF" Padding="20">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/icon.png" Width="50" Height="50" Margin="0,0,15,0"/>
                    <TextBlock Text="МебельОрг - Каталог товаров" 
                               FontFamily="Calibri"
                               FontSize="24" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"
                               Foreground="#0000FF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Гость" 
                               FontFamily="Calibri"
                               FontSize="16" 
                               VerticalAlignment="Center" 
                               Margin="0,0,15,0"/>
                    <Button x:Name="LogoutBtn" 
                            Content="Выход" 
                            Width="100" 
                            Height="35"
                            Click="LogoutBtn_Click"
                            Style="{StaticResource ButtonPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsItemsControl" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCardStyle}" 
                                Width="300" 
                                Height="450"
                                Margin="10">
                            <Border.Background>
                                <SolidColorBrush Color="White"/>
                            </Border.Background>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Фото товара -->
                                <Image Grid.Row="0" 
                                       Source="{Binding PhotoFullPath}" 
                                       Stretch="Uniform"
                                       Margin="5"/>

                                <!-- Информация о товаре -->
                                <StackPanel Grid.Row="1" Margin="10,5">
                                    <TextBlock Text="{Binding CategoryName}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               Foreground="#666666"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding ProductName}" 
                                               FontFamily="Calibri"
                                               FontSize="14" 
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               TextWrapping="Wrap"
                                               Foreground="#666666"
                                               Margin="0,0,0,10"/>
                                    <TextBlock FontFamily="Calibri" FontSize="12">
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding ManufacturerName}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Calibri" FontSize="12">
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding SupplierName}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Цена и наличие -->
                                <StackPanel Grid.Row="2" Margin="10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding PriceWithDiscount}" 
                                                   FontFamily="Calibri"
                                                   FontSize="20" 
                                                   FontWeight="Bold"
                                                   Foreground="#0000FF"/>
                                        <TextBlock Text=" руб." 
                                                   FontFamily="Calibri"
                                                   FontSize="14" 
                                                   VerticalAlignment="Bottom"
                                                   Margin="5,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock FontFamily="Calibri" FontSize="12">
                                        <Run Text="На складе: "/>
                                        <Run Text="{Binding QuantityInStock}" FontWeight="Bold"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding UnitName}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DiscountText}" 
                                               FontFamily="Calibri"
                                               FontSize="12" 
                                               Foreground="Red"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Футер -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20">
            <TextBlock Text="{Binding TotalProductsText}" 
                       FontFamily="Calibri"
                       FontSize="14" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Growl для уведомлений -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" 
                      Grid.Row="0"
                      HorizontalAlignment="Right">
            <StackPanel hc:Growl.GrowlParent="True" 
                        VerticalAlignment="Top" 
                        Margin="0,10,10,10"/>
        </ScrollViewer>
    </Grid>
</Page>
