<Application x:Class="Demovar5.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demovar5"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- HandyControl Themes -->
                <hc:ThemeResources/>
                <hc:Theme/>
                <!-- Custom Styles -->
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Color Definitions from Requirements -->
            <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#00FFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0000FF"/>
            <SolidColorBrush x:Key="HighDiscountBrush" Color="#008080"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
